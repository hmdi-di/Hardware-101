    },
    {
        "id": "20ef04d1cb59c98d",
        "type": "function",
        "z": "2105b94cc1e53f3f",
        "name": "function speed winrate",
        "func": "// ดึงค่าสะสมล่าสุดที่ Node-RED จำไว้\nlet win = flow.get('total_speed_win') || 0;\nlet lose = flow.get('total_speed_lose') || 0;\n\n// หาจำนวนรอบทั้งหมด (เอาชนะกับแพ้มาบวกกันชัวร์กว่า)\nlet total = win + lose;\nlet percent = 0;\n\n// ป้องกัน error ตัวหารเป็น 0\nif (total > 0) {\n    percent = (win / total) * 100;\n}\n\n// ส่งค่าเปอร์เซ็นต์ออกไป (ทศนิยม 2 ตำแหน่ง)\nmsg.payload = Number(percent.toFixed(2));\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 900,
        "y": 260,
        "wires": [
            [
                "6b1e03ed29b6088d"
            ]
        ]
    },
    {
        "id": "5f5232a4197b40b5",
        "type": "function",
        "z": "2105b94cc1e53f3f",
        "name": "function memory winrate",
        "func": "// ดึงค่าสะสมล่าสุดที่ Node-RED จำไว้\nlet win = flow.get('total_memory_win') || 0;\nlet lose = flow.get('total_memory_lose') || 0;\n\nlet total = win + lose;\nlet percent = 0;\n\nif (total > 0) {\n    percent = (win / total) * 100;\n}\n\nmsg.payload = Number(percent.toFixed(2));\nreturn msg;",
        "outputs": 1,
