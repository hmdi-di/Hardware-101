    {
        "id": "7f0367875b271224",
        "type": "function",
        "z": "2105b94cc1e53f3f",
        "name": "function speed rounds",
        "func": "// รับจำนวนรอบที่เล่นจากตานี้\nlet session_val = Number(msg.payload) || 0;\n\n// ดึงจำนวนรอบสะสมเดิม (ถ้าไม่มีให้เริ่มที่ 0)\nlet total_val = flow.get('total_speed_rounds') || 0; \n\n// เอามาบวกทบกัน\ntotal_val += session_val;\n\n// บันทึกค่าสะสมกลับลงไป\nflow.set('total_speed_rounds', total_val);         \n\n// ส่งยอดรวมไปแสดงที่กราฟ\nmsg.payload = total_val;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
