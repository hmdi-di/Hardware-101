        ]
    },
    {
        "id": "402146f6f810ed92",
        "type": "function",
        "z": "2105b94cc1e53f3f",
        "name": "function memory rounds",
        "func": "let session_val = Number(msg.payload) || 0;\nlet total_val = flow.get('total_memory_rounds') || 0;\ntotal_val += session_val;\nflow.set('total_memory_rounds', total_val);\n\nmsg.payload = total_val;\nmsg.topic = \"Memory Game\"; // ✅ ต้องเพิ่มบรรทัดนี้ เพื่อบอกกราฟว่านี่คือแท่งของ Memory นะ\n\nreturn msg;",
        "outputs": 1,
